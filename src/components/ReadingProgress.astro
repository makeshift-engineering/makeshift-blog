---
// ReadingProgress — renders a thin progress bar below the navbar on blog post pages.
// The bar width reflects how far the reader has scrolled through the article.
---

<div class="reading-progress-container" id="reading-progress-container">
  <div class="reading-progress-bar" id="reading-progress-bar"></div>
</div>

<script>
  function initReadingProgress() {
    const bar = document.getElementById("reading-progress-bar");
    const container = document.getElementById("reading-progress-container");
    if (!bar || !container) return;

    // Only show on blog post pages (pages with a .prose element)
    const prose = document.querySelector(".prose");
    if (!prose) {
      container.style.display = "none";
      return;
    }

    container.style.display = "block";

    const navbar = document.getElementById("main-nav");

    function updateProgress() {
      if (!bar || !container) return;
      const article = document.querySelector(".post-page") || prose;
      if (!article) return;

      const rect = article.getBoundingClientRect();
      const articleTop = rect.top + window.scrollY;
      const articleHeight = rect.height;
      const windowHeight = window.innerHeight;
      const scrollY = window.scrollY;

      // Progress = how far we've scrolled through the article
      const start = articleTop;
      const end = articleTop + articleHeight - windowHeight;
      const scrollRange = end - start;

      let progress = 0;
      if (articleHeight <= 0) {
        progress = 0;
      } else if (scrollRange <= 0) {
        // If the article is no taller than the viewport, it's fully read
        // once the end of the article has entered the viewport (or if it fits on load)
        progress = scrollY >= end ? 1 : 0;
      } else {
        progress = (scrollY - start) / scrollRange;
      }

      const percentage = Math.min(100, Math.max(0, progress * 100));
      bar.style.width = `${percentage}%`;

      // Sync position with navbar visibility
      const navHidden = navbar?.classList.contains("navbar--hidden");
      container.style.top = navHidden ? "0" : "";
    }

    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            updateProgress();
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true }
    );

    // Also update on resize
    window.addEventListener("resize", updateProgress, { passive: true });

    // Initial
    updateProgress();
  }

  initReadingProgress();
  document.addEventListener("astro:after-swap", initReadingProgress);
</script>

<style>
  .reading-progress-container {
    position: fixed;
    top: var(--nav-height);
    left: 0;
    right: 0;
    height: 2px;
    z-index: 101;
    background: transparent;
    display: none; /* hidden by default, shown via JS on blog pages */
    transition: top var(--duration-base) var(--ease-out);
  }

  .reading-progress-bar {
    height: 100%;
    width: 0%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent-glow);
    transition: width 80ms linear;
    will-change: width;
  }
</style>
