---
import CategoryBadge from './CategoryBadge.astro';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  category: string;
  slug: string;
  readTime?: string;
  featured?: boolean;
}

const { title, description, publishDate, category, slug, readTime, featured = false } = Astro.props;

const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a href={`/blog/${slug}`} class:list={['post-card', { featured }]}>
  <div class="card-content">
    <div class="card-meta">
      <CategoryBadge category={category} />
      <span class="card-date">{formattedDate}</span>
      {readTime && <span class="card-read-time">{readTime}</span>}
    </div>
    <h3 class="card-title">{title}</h3>
    <p class="card-description">{description}</p>
  </div>
  <div class="card-arrow">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
      <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
</a>

<style>
  .post-card {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--duration-base) var(--ease-out);
    color: inherit;
  }

  .post-card:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-3);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
  }

  .post-card.featured {
    border-color: var(--border-2);
    background: linear-gradient(135deg, var(--bg-card), var(--accent-subtle));
  }

  .post-card.featured:hover {
    border-color: rgba(146, 227, 169, 0.2);
  }

  .card-content {
    flex: 1;
    min-width: 0;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .card-date,
  .card-read-time {
    font-size: 0.8125rem;
    color: var(--fg-3);
    font-family: var(--font-mono);
  }

  .card-read-time::before {
    content: '·';
    margin-right: 0.75rem;
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--fg-0);
    margin-bottom: 0.5rem;
    line-height: 1.4;
    letter-spacing: -0.01em;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .post-card:hover .card-title {
    color: var(--accent);
  }

  .card-description {
    font-size: 0.9375rem;
    color: var(--fg-2);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-arrow {
    color: var(--fg-3);
    flex-shrink: 0;
    margin-top: 0.25rem;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .post-card:hover .card-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .post-card {
      padding: 1.25rem;
    }

    .card-title {
      font-size: 1rem;
    }
  }
</style>
