---
interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: string;
  publishDate?: Date;
  author?: string;
}

const {
  title,
  description,
  canonicalURL = Astro.url.href,
  ogImage = "/og-default.png",
  ogType = "website",
  publishDate,
  author = "Makeshift Engineering",
} = Astro.props;

const siteName = "Makeshift Engineering Blog";
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;

// JSON-LD structured data
const jsonLd =
  ogType === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        author: {
          "@type": "Person",
          name: author,
        },
        publisher: {
          "@type": "Organization",
          name: "Makeshift Engineering",
          url: "https://makeshift.pro",
        },
        url: canonicalURL,
        image: new URL(ogImage, Astro.site).href,
        ...(publishDate ? { datePublished: publishDate.toISOString() } : {}),
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: siteName,
        description,
        url: Astro.site?.href ?? canonicalURL,
        publisher: {
          "@type": "Organization",
          name: "Makeshift Engineering",
          url: "https://makeshift.pro",
        },
      };

// Script-safe JSON-LD serializer: escapes characters that could break out
// of a <script> block or cause issues in HTML context (CWE-79)
const safeJsonLd = JSON.stringify(jsonLd)
  .replace(/</g, "\\u003c")
  .replace(/>/g, "\\u003e")
  .replace(/&/g, "\\u0026")
  .replace(/\u2028/g, "\\u2028")
  .replace(/\u2029/g, "\\u2029");
---

<!-- Primary Meta -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={author} />
<link rel="canonical" href={canonicalURL} />

<!-- Favicons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
  rel="stylesheet"
/>

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={siteName} />
<meta property="og:image" content={new URL(ogImage, Astro.site).href} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

<!-- RSS Autodiscovery -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={siteName}
  href={new URL("/rss.xml", Astro.site).href}
/>

{
  publishDate && (
    <meta
      property="article:published_time"
      content={publishDate.toISOString()}
    />
  )
}

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={safeJsonLd} />
