---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

// Only show h2 and h3
const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  filteredHeadings.length > 0 && (
    <aside class="toc" aria-label="Table of Contents">
      <div class="toc-header">
        <span class="toc-label">// on this page</span>
      </div>
      <nav>
        <div class="toc-track">
          <div class="toc-indicator" id="toc-indicator" />
          <ul class="toc-list">
            {filteredHeadings.map((heading) => (
              <li class:list={["toc-item", `toc-depth-${heading.depth}`]}>
                <a
                  href={`#${heading.slug}`}
                  class="toc-link"
                  data-heading-slug={heading.slug}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    </aside>
  )
}

<script>
  function initTocHighlight() {
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>(
      ".toc-link[data-heading-slug]"
    );
    const indicator = document.getElementById("toc-indicator");
    if (tocLinks.length === 0 || !indicator) return;

    const slugs = Array.from(tocLinks).map((link) => link.dataset.headingSlug!);
    const headingElements = slugs
      .map((slug) => document.getElementById(slug))
      .filter((el): el is HTMLElement => el !== null);

    if (headingElements.length === 0) return;

    let activeSlug: string | null = null;

    function setActive(slug: string | null) {
      if (slug === activeSlug) return;
      activeSlug = slug;

      tocLinks.forEach((link) => {
        const isActive = link.dataset.headingSlug === slug;
        link.classList.toggle("active", isActive);
      });

      // Move the indicator to the active link
      if (slug) {
        const activeLink = document.querySelector<HTMLAnchorElement>(
          `.toc-link[data-heading-slug="${slug}"]`
        );
        if (activeLink) {
          const track = activeLink.closest(".toc-track") as HTMLElement;
          if (track) {
            const trackRect = track.getBoundingClientRect();
            const linkRect = activeLink.getBoundingClientRect();
            indicator!.style.top = `${linkRect.top - trackRect.top}px`;
            indicator!.style.height = `${linkRect.height}px`;
            indicator!.style.opacity = "1";
          }
        }
      } else {
        indicator!.style.opacity = "0";
      }
    }

    // Scroll-based heading detection
    const navHeight =
      parseInt(
        getComputedStyle(document.documentElement).getPropertyValue(
          "--nav-height"
        )
      ) || 64;

    function onScroll() {
      let closest: HTMLElement | null = null;
      let closestDist = Infinity;

      headingElements.forEach((el) => {
        const rect = el.getBoundingClientRect();
        const dist = Math.abs(rect.top - navHeight - 20);
        if (rect.top <= navHeight + 60 && dist < closestDist) {
          closestDist = dist;
          closest = el;
        }
      });

      if (closest) {
        setActive((closest as HTMLElement).id);
      } else {
        const firstRect = headingElements[0].getBoundingClientRect();
        if (firstRect.top > navHeight) {
          setActive(null);
        }
      }
    }

    let scrollTicking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (!scrollTicking) {
          requestAnimationFrame(() => {
            onScroll();
            scrollTicking = false;
          });
          scrollTicking = true;
        }
      },
      { passive: true }
    );

    // Initial check
    onScroll();
  }

  // Run on initial load and on Astro page navigations
  initTocHighlight();
  document.addEventListener("astro:after-swap", initTocHighlight);
</script>

<style>
  .toc {
    position: sticky;
    top: calc(var(--nav-height) + 2rem);
    max-height: calc(100vh - var(--nav-height) - 4rem);
    overflow-y: auto;
    padding: 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .toc-header {
    margin-bottom: 1rem;
  }

  .toc-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--fg-3);
    letter-spacing: 0.1em;
    text-transform: lowercase;
  }

  .toc-track {
    position: relative;
    border-left: 1px solid var(--border-2);
  }

  .toc-indicator {
    position: absolute;
    left: -1px;
    top: 0;
    width: 2px;
    height: 0;
    background: var(--accent);
    opacity: 0;
    transition:
      top var(--duration-base) var(--ease-out),
      height var(--duration-base) var(--ease-out),
      opacity var(--duration-fast) var(--ease-out);
    border-radius: 1px;
    z-index: 1;
  }

  .toc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .toc-link {
    display: block;
    font-size: 0.8125rem;
    color: var(--fg-3);
    text-decoration: none;
    padding: 0.3125rem 0.75rem;
    transition: color var(--duration-fast) var(--ease-out);
    line-height: 1.4;
  }

  .toc-link:hover {
    color: var(--fg-1);
  }

  .toc-link.active {
    color: var(--fg-0);
  }

  .toc-depth-3 .toc-link {
    padding-left: 1.5rem;
    font-size: 0.75rem;
  }
</style>
