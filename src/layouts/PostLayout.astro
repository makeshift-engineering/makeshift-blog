---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
}

const { entry, headings } = Astro.props;
const { title, description, publishDate, updatedDate, author, authorGithub, category, tags } = entry.data;

const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const updatedFormatted = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Rough read time: ~200 words per minute
const wordCount = entry.body?.split(/\s+/).length ?? 0;
const readTime = Math.max(1, Math.ceil(wordCount / 200));
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  publishDate={publishDate}
  author={author}
>
  <article class="post-page">
    <div class="container">
      <!-- Back link -->
      <a href="/" class="back-link">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M10 13L5 8L10 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        All posts
      </a>

      <div class="post-layout">
        <!-- Post content -->
        <div class="post-main">
          <!-- Header -->
          <header class="post-header">
            <div class="post-meta">
              <CategoryBadge category={category} size="md" />
              <span class="meta-sep">·</span>
              <time datetime={publishDate.toISOString()}>{formattedDate}</time>
              <span class="meta-sep">·</span>
              <span>{readTime} min read</span>
            </div>

            <h1 class="post-title">{title}</h1>
            <p class="post-description">{description}</p>

            <div class="post-author">
              <span class="author-label">by</span>
              <a
                href={`https://github.com/${authorGithub}`}
                target="_blank"
                rel="noopener"
                class="author-link"
              >
                {author}
              </a>
            </div>

            {updatedFormatted && (
              <p class="post-updated">Updated {updatedFormatted}</p>
            )}
          </header>

          <!-- Tags -->
          {tags.length > 0 && (
            <div class="post-tags">
              {tags.map((tag) => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
          )}

          <!-- Content -->
          <div class="prose">
            <slot />
          </div>
        </div>

        <!-- Sidebar: Table of Contents -->
        <aside class="post-sidebar">
          <TableOfContents headings={headings} />
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post-page {
    padding: 2rem 0 4rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--fg-3);
    text-decoration: none;
    margin-bottom: 2rem;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .back-link:hover {
    color: var(--fg-0);
  }

  .post-layout {
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: 3rem;
    align-items: start;
  }

  .post-main {
    min-width: 0;
  }

  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    font-size: 0.8125rem;
    color: var(--fg-3);
    font-family: var(--font-mono);
  }

  .meta-sep {
    color: var(--fg-3);
    opacity: 0.5;
  }

  .post-title {
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.2;
    color: var(--fg-0);
    margin-bottom: 0.75rem;
  }

  .post-description {
    font-size: 1.125rem;
    color: var(--fg-2);
    line-height: 1.6;
    max-width: 600px;
  }

  .post-author {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--fg-3);
  }

  .author-label {
    margin-right: 0.25rem;
  }

  .author-link {
    color: var(--fg-1);
    text-decoration: none;
    border-bottom: 1px solid var(--border-2);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .author-link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .post-updated {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--fg-3);
    font-style: italic;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-3);
    background: var(--bg-2);
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
  }

  .post-sidebar {
    display: block;
  }

  @media (max-width: 1024px) {
    .post-layout {
      grid-template-columns: 1fr;
    }

    .post-sidebar {
      display: none;
    }

    .post-title {
      font-size: 2rem;
    }
  }

  @media (max-width: 768px) {
    .post-title {
      font-size: 1.75rem;
    }

    .post-description {
      font-size: 1rem;
    }
  }
</style>
