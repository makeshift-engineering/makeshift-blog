---
import SEOHead from "../components/SEOHead.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: string;
  publishDate?: Date;
  author?: string;
}

const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead {...props} />
  </head>
  <body>
    <Navbar />
    <main id="main-content" style={`padding-top: var(--nav-height);`}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
